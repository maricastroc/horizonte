# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
*.bak
*.orig
*.rej
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# o template não tem segredo e deve ser versionado
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude

# dados locais de desenvolvimento: WAV de análise (testes de corpus), álbuns
# da aquisição manual, cache de download da curadoria e bancadas
/.cache

# mídia: arquivos novos ficam fora do Git; o que já está versionado continua
/public/music

# python
__pycache__/
*.pyc

/design_handoff_horizonte/
