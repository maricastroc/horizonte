# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# o template não tem segredo e deve ser versionado
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.claude

# cache de download da curadoria (regenerável: scripts/fetch-curation.py)
/.cache

# Assets de mídia: vivem no object storage/CDN, não no Git.
# Só remova do índice DEPOIS de rodar `npm run media:upload` e de definir
# NEXT_PUBLIC_MEDIA_BASE_URL na Vercel:
#   git rm -r --cached public/music
/public/music

# python
__pycache__/
*.pyc
