# Base pública do object storage/CDN que serve public/music.
# Vem do output de `npm run media:upload`.
# Vazio = o app cai em public/music (desenvolvimento local sem configuração).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Id do Blob store, quando a conexão usa OIDC (o caso deste projeto).
# Não é segredo: faz parte da URL pública. Descubra com `vercel blob list-stores`.
# Junto com VERCEL_OIDC_TOKEN (vindo de `vercel env pull`), dispensa o token legado.
BLOB_STORE_ID=

# Alternativa legada ao par OIDC acima. Token de escrita do Vercel Blob. Usado SOMENTE pelo script de upload,
# nunca chega ao bundle do cliente. Não versionar.
# Obtido em vercel.com → Storage → Blob → .env.local, ou `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
