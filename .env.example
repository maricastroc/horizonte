# Base pública do object storage/CDN que serve public/music.
# Vem do output de `npm run media:upload`.
# Vazio = o app cai em public/music (desenvolvimento local sem configuração).
NEXT_PUBLIC_MEDIA_BASE_URL=

# Token de escrita do Vercel Blob. Usado SOMENTE pelo script de upload,
# nunca chega ao bundle do cliente. Não versionar.
# Obtido em vercel.com → Storage → Blob → .env.local, ou `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
